---
import Base from '../layouts/Base.astro';
import Bin3D from '../components/Bin3D.astro';
import ScaleTrio from '../components/ScaleTrio.astro';
import Steps from '../components/Steps.astro';
import Doors from '../components/Doors.astro';
import Composition from '../components/Composition.astro';
import ResourceStrip from '../components/ResourceStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import Statement from '../components/Statement.astro';
import Cite from '../components/Cite.astro';
import { href, STATEMENT } from '../data/site';
import { LEVIES } from '../data/levies';
const vic = LEVIES[0].zones[0].rate, nsw = LEVIES[1].zones[0].rate, qld = LEVIES[2].zones[0].rate;
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div class="hero__text">
        <h1>A bin built for plasterboard.</h1>
        <div class="hero__side">
          <p class="lede">We drop an enclosed, weatherproof bin at your transfer station or site. Plasterboard goes in through the side, stays dry, and we take it away on our hook-lift trucks to be recycled into gypsum.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={href('/book/')}>Book a bin</a>
            <a class="btn btn--ghost" href={href('/councils/#calculator')}>Work out what it saves</a>
          </div>
          <p class="initiative">A <span class="initiative__word"><span class="initiative__re">Re</span><span class="initiative__cycle">cycle</span></span> initiative</p>
        </div>
      </div>
      <div class="hero__art">
        <Bin3D id="hero-bin" autoOpen />
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap"><ScaleTrio /></div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <h2>How it works</h2>
        <a href={href('/how-it-works/')}>The full run-through</a>
      </div>
      <Steps />
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="head-row"><h2>Who it’s for</h2></div>
      <Doors />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div>
        <h2>Every tonne buried is a tonne of levy</h2>
        <p>In 2026–27 a tonne of waste to a metropolitan landfill carries ${vic.toFixed(2)} of state levy in Victoria, ${nsw.toFixed(2)} in New South Wales and ${qld} in Queensland — before the gate fee.<Cite id="levy-states" /> Plasterboard in its own bin leaves your site as a recyclable instead.</p>
        <p>Pick your state, put in the tonnes, and see what it adds up to.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={href('/councils/#calculator')}>Open the calculator</a>
          <a class="btn btn--ghost" href={href('/levy/')}>Every state’s levy</a>
        </div>
      </div>
      <div class="levy-card" aria-label="Example: 500 tonnes a year">
        <p class="levy-card__k">500 t of plasterboard a year, metropolitan Victoria</p>
        <p class="levy-card__v">${Math.round(500 * vic).toLocaleString('en-AU')}</p>
        <p class="levy-card__k">in state levy that no longer applies</p>
        <div class="dim levy-card__dim"><i class="tick tick--l"></i><span>about 72 full bins · a 450 m line</span><i class="tick tick--r"></i></div>
        <p class="levy-card__s">Levy only, before gate fees. Bin count assumes about 7 t a load.<Cite id="density" label="estimate" /></p>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap grid-2">
      <div>
        <h2>Almost all of it is gypsum</h2>
        <p>Strip off the paper and a sheet of plasterboard is mostly the same mineral that gets quarried to make new board. Recovered, it goes back into plasterboard, into cement, and onto farms as a soil conditioner.<Cite id="uses" /></p>
        <p><a href={href('/the-journey/')}>Follow a sheet from the wall to the farm</a></p>
      </div>
      <Composition />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap ask">
      <div>
        <h2>One rule at the bin: plasterboard only</h2>
        <p>No fibro, no foil-backed board, no tiles, timber or rubbish. If you can’t tell whether a sheet is plasterboard or fibro, leave it out.<Cite id="fibro" label="why" /></p>
      </div>
      <a class="btn btn--ghost" href={href('/what-goes-in/')}>What goes in, what stays out</a>
    </div>
  </section>

  <section class="section section--paper section--tight">
    <div class="wrap">
      <div class="head-row">
        <h2>Print and go</h2>
        <a href={href('/resources/')}>All resources</a>
      </div>
      <ResourceStrip only={['bin-sign', 'gate-guide']} />
    </div>
  </section>

  <CtaBand />

  <Statement quote={STATEMENT.quote} highlight={STATEMENT.highlight} by={STATEMENT.by} />
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem); }
  .hero .wrap { display: grid; gap: clamp(2rem, 5vw, 3.5rem); }
  .hero__text { max-width: 44rem; }
  @media (min-width: 1040px) {
    .hero__text { max-width: none; display: grid; grid-template-columns: 1.15fr 1fr; gap: 3rem; align-items: end; }
    .hero__text h1 { margin: 0; }
    .hero__side .lede { margin-bottom: 0; }
  }
  .hero h1 { font-size: var(--step-5); letter-spacing: -0.045em; line-height: 0.95; }
  .hero__art { padding-top: 0.5rem; }
  .initiative { margin: 2rem 0 0; font: 700 var(--step-3)/1.1 var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .initiative__word { font-weight: 800; }
  .initiative__re { color: var(--recycle-brown); }
  .initiative__cycle { color: #000; }
  @media (max-width: 600px) {
    .hero { padding-block: 1.5rem 2.5rem; }
    .hero .wrap { gap: 1.25rem; }
    .hero__text { display: contents; }
    .hero h1 { order: 1; margin: 0; font-size: clamp(2.6rem, 11.5vw, 3.4rem); }
    .hero__art { order: 2; padding-top: 0.25rem; }
    .hero__side { order: 3; }
    .hero__side .lede { font-size: 1.0625rem; }
    .hero__side .btn-row { margin-top: 1.25rem; }
    .initiative { font-size: clamp(1.5rem, 7.2vw, 1.9rem); margin-top: 1.5rem; }
  }
  .head-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; margin-bottom: 2rem; }
  .head-row h2 { margin: 0; }
  .head-row a { display: inline-block; padding-block: 0.6rem; margin-block: -0.6rem; }
  .levy-card { background: var(--chalk); border-radius: var(--radius-m); padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--rule); }
  .levy-card__k { color: var(--muted); margin: 0; }
  .levy-card__v { font: 800 var(--step-4)/1.05 var(--font-display); color: var(--steel); letter-spacing: -0.03em; margin: 0.35rem 0; }
  .levy-card__dim { margin: 1.5rem 0 0.75rem; }
  .levy-card__s { font-size: 0.9rem; color: var(--muted); margin: 0; }
  .ask { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; }
  .ask h2 { font-size: var(--step-2); }
  .ask p { margin: 0; }
  @media (max-width: 480px) { .ask .btn { width: 100%; min-height: 3.25rem; } }
</style>
