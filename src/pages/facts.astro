---
import Base from '../layouts/Base.astro';
import { FACTS } from '../data/facts';
import { href } from '../data/site';
---
<Base title="Facts and sources" description="Every figure on the Plastercycle site and where it comes from.">
  <section class="page-head">
    <div class="wrap">
      <p class="crumb"><a href={href('/')}>Home</a> / Facts and sources</p>
      <h1>The numbers, and where they come from.</h1>
      <p>Every figure on this site links here. Where we’ve done the arithmetic ourselves, we say so and show how.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <ol class="facts">
        {FACTS.map((f) => (
          <li id={f.id} class="facts__item">
            <h2>{f.title}</h2>
            <p>{f.statement}</p>
            <p class="facts__kind">{f.kind === 'derived' ? 'Our calculation from the sources below' : 'Reported by'}</p>
            <ul class="facts__src">
              {f.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
            </ul>
          </li>
        ))}
      </ol>
      <p class="facts__checked">Checked October 2026. Levy rates change every 1 July.</p>
    </div>
  </section>
</Base>

<style>
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .facts__item { background: var(--paper); border-radius: var(--radius-m); padding: clamp(1.25rem, 3vw, 1.75rem); scroll-margin-top: 6rem; border-left: 4px solid transparent; }
  .facts__item:target { border-left-color: var(--steel); box-shadow: 0 0 0 2px var(--steel) inset; }
  .facts__item h2 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .facts__item p { max-width: 50rem; }
  .facts__kind { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.25rem; font-weight: 600; }
  .facts__src { margin: 0; padding-left: 1.1rem; font-size: 0.95rem; }
  .facts__checked { margin-top: 1.5rem; color: var(--muted); font-size: 0.95rem; }
</style>
