---
import Cite from './Cite.astro';
---
<figure class="cmp">
  <div class="cmp__bar" role="img" aria-label="Plasterboard by weight: about 94% gypsum and 6% paper liner">
    <div class="cmp__g"><strong>Gypsum</strong><span>about 94%</span></div>
    <div class="cmp__p"><strong>Paper</strong><span>~6%</span></div>
  </div>
  <figcaption>What a sheet is made of, by weight.<Cite id="composition" /> Gypsum is calcium sulphate dihydrate — the same mineral that’s quarried for new board. The paper is the liner on each face.</figcaption>
</figure>

<style>
  .cmp { margin: 0; }
  .cmp__bar { display: grid; grid-template-columns: 94fr 6fr; height: clamp(110px, 14vw, 150px); border: 1px solid var(--rule-strong); border-radius: var(--radius-s); overflow: hidden; }
  .cmp__g {
    background:
      radial-gradient(circle at 20% 30%, rgba(0,0,0,0.035) 0 1px, transparent 1.5px) 0 0 / 9px 9px,
      radial-gradient(circle at 60% 70%, rgba(0,0,0,0.03) 0 1px, transparent 1.5px) 0 0 / 13px 13px,
      #fbfbfa;
    padding: 1rem 1.25rem; display: flex; flex-direction: column; justify-content: flex-end;
  }
  .cmp__g strong { font: 800 var(--step-3)/1 var(--font-display); color: var(--navy); letter-spacing: -0.02em; }
  .cmp__g span { color: var(--muted); }
  .cmp__p { background: #d9cdb4; border-left: 1px solid var(--rule-strong); position: relative; }
  .cmp__p strong, .cmp__p span { position: absolute; right: calc(100% + 0.75rem); white-space: nowrap; font-size: var(--step--1); }
  .cmp__p strong { top: 0.9rem; color: var(--ink); }
  .cmp__p span { top: 2.2rem; color: var(--muted); }
  .cmp figcaption { margin-top: 1rem; color: var(--muted); font-size: 1rem; max-width: 46rem; }
</style>
