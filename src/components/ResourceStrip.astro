---
import { DOWNLOADS, href } from '../data/site';
interface Props { only?: string[] }
const { only } = Astro.props;
const items = only ? DOWNLOADS.filter((d) => only.some((o) => d.file.includes(o))) : DOWNLOADS;
---
<ul class="rs">
  {items.map((d) => (
    <li>
      <a class="rs__item" href={href(d.file)} download>
        <span class="rs__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" /><path d="M12 11v6M9 14l3 3 3-3" /></svg></span>
        <span class="rs__body"><strong>{d.title}</strong><span>{d.blurb}</span></span>
        <span class="rs__dl">PDF</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .rs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  .rs__item { display: grid; grid-template-columns: auto 1fr auto; gap: 0.9rem; align-items: center; background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius-m); padding: 1rem 1.1rem; text-decoration: none; color: var(--ink); min-height: 4.5rem; }
  .rs__item:hover { border-color: var(--steel); }
  .rs__icon { color: var(--steel); display: grid; place-items: center; }
  .rs__body { display: grid; gap: 0.15rem; } .rs__body strong { color: var(--navy); font-family: var(--font-display); } .rs__body span { font-size: 0.9rem; color: var(--muted); }
  .rs__dl { font: 700 0.75rem var(--font-display); color: var(--navy); border: 1.5px solid var(--rule-strong); border-radius: 3px; padding: 0.2rem 0.4rem; }
</style>
