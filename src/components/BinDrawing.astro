---
/**
 * The bin as an elevation drawing with live dimension lines.
 * Toggle swaps the closed / open side elevations.
 */
import { BIN, href } from '../data/site';
interface Props { start?: 'closed' | 'open'; id?: string }
const { start = 'open', id = 'bin' } = Astro.props;
const fmt = (n: number) => n.toLocaleString('en-AU');
---
<figure class="bd" data-state={start} id={id}>
  <div class="bd__top dim"><i class="tick tick--l"></i><span>{fmt(BIN.length)} mm overall length</span><i class="tick tick--r"></i></div>
  <div class="bd__stage">
    <div class="bd__art">
      <img class="bd__img bd__img--closed" src={href('/images/bin-side-closed.webp')} width="1210" height="439"
        alt="Side view of the blue Plastercycle bin with its loading panels shut" fetchpriority="high" />
      <img class="bd__img bd__img--open" src={href('/images/bin-side-open.webp')} width="1004" height="378"
        alt="Side view of the bin with both top-hinged loading panels lifted, showing the smooth grey interior" />
    </div>
    <div class="bd__side" aria-hidden="true">
      <div class="bd__vdim"><span>{fmt(BIN.height)}</span></div>
    </div>
  </div>
  <figcaption class="bd__cap">
    <div class="bd__toggle" role="group" aria-label="Loading panels">
      <button type="button" data-set="closed" aria-pressed={start === 'closed' ? 'true' : 'false'}>Panels shut</button>
      <button type="button" data-set="open" aria-pressed={start === 'open' ? 'true' : 'false'}>Panels open</button>
    </div>
    <span class="bd__note">{fmt(BIN.width)} mm wide · loading opening starts about {fmt(BIN.sill)} mm off the ground</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.bd').forEach((fig) => {
    fig.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => {
      b.addEventListener('click', () => {
        const s = b.dataset.set!;
        fig.dataset.state = s;
        fig.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      });
    });
  });
</script>

<style>
  .bd { margin: 0; }
  .bd__top { margin-bottom: 0.9rem; margin-right: 3.25rem; }
  .bd__stage { display: grid; grid-template-columns: 1fr 3.25rem; align-items: stretch; }
  .bd__art { position: relative; aspect-ratio: 1210 / 439; }
  .bd__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: center bottom;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .bd[data-state='closed'] .bd__img--open,
  .bd[data-state='open'] .bd__img--closed { opacity: 0; transform: translateY(4px); pointer-events: none; }
  .bd__flag {
    position: absolute; left: 50%; top: -0.6rem; transform: translate(-50%, -100%);
    background: var(--navy); color: #fff; font-size: var(--step--1); font-weight: 600;
    padding: 0.35rem 0.7rem; border-radius: var(--radius-s); white-space: nowrap;
    transition: opacity 0.3s ease;
  }
  .bd__flag::after {
    content: ''; position: absolute; left: 50%; bottom: -6px; width: 12px; height: 12px;
    background: var(--navy); transform: translateX(-50%) rotate(45deg);
  }
  .bd[data-state='closed'] .bd__flag { opacity: 0; }
  .bd__top { position: relative; }
  .bd__side { display: flex; justify-content: center; }
  .bd__vdim {
    position: relative; width: 1px; background: var(--rule-strong); height: 100%;
    display: flex; align-items: center; justify-content: center;
  }
  .bd__vdim::before, .bd__vdim::after { content: ''; position: absolute; left: -6px; width: 13px; height: 1px; background: var(--rule-strong); }
  .bd__vdim::before { top: 0; } .bd__vdim::after { bottom: 0; }
  .bd__vdim span {
    background: var(--bd-bg, var(--chalk)); color: var(--muted); font-size: var(--step--1); font-weight: 500;
    writing-mode: vertical-rl; transform: rotate(180deg); padding: 0.4rem 0;
  }
  .bd__cap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; margin-top: 1.1rem; }
  .bd__toggle { display: inline-flex; border: 2px solid var(--navy); border-radius: var(--radius-s); overflow: hidden; }
  .bd__toggle button {
    font: 600 0.95rem var(--font-body); background: transparent; color: var(--navy); border: 0;
    padding: 0.6rem 1rem; min-height: 2.75rem; cursor: pointer;
  }
  .bd__toggle button[aria-pressed='true'] { background: var(--navy); color: #fff; }
  .bd__note { color: var(--muted); font-size: var(--step--1); }
  @media (max-width: 560px) {
    .bd__flag { display: none; }
    .bd__stage { grid-template-columns: 1fr 2.25rem; }
    .bd__top { margin-right: 2.25rem; }
  }
</style>
