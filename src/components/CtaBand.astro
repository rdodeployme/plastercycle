---
import { href } from '../data/site';
interface Props { title?: string; body?: string }
const {
  title = 'Put a bin where the plasterboard turns up.',
  body = 'Tell us about your transfer station, depot or site and roughly how much board comes through. We’ll come back to you with a plan and a quote.',
} = Astro.props;
---
<section class="band">
  <div class="wrap band__in">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="band__act">
      <a class="btn btn--light" href={href('/book/')}>Book a bin</a>
      <a class="band__alt" href={href('/councils/#calculator')}>Work out your levy savings</a>
    </div>
  </div>
</section>

<style>
  .band { background: var(--steel); color: #fff; padding-block: clamp(3rem, 7vw, 5rem); position: relative; overflow: hidden; }
  .band__in { position: relative; z-index: 1; display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 880px) { .band__in { grid-template-columns: 1.6fr 1fr; } }
  .band h2 { color: #fff; }
  .band p { color: #e3ebfb; font-size: var(--step-1); line-height: 1.5; }
  .band__act { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .band__alt { color: #fff; font-weight: 600; display: inline-block; padding-block: 0.6rem; }
  @media (max-width: 480px) { .band__act { align-items: stretch; } .band__act .btn { width: 100%; min-height: 3.25rem; } .band__alt { text-align: center; } .band p { font-size: 1.0625rem; } }
  .band__alt:hover { color: var(--green); }
  @media (min-width: 880px) { .band__act { align-items: flex-end; } }
</style>
